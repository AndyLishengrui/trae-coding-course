            "code": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nint main() {\n    int V;\n    cin >> V;  // \u8f93\u5165\u521d\u59cb\u503cV\n    \n    // \u521b\u5efa\u5e76\u521d\u59cb\u5316\u957f\u5ea6\u4e3a10\u7684vector\n    vector<int> N(10);  // C++11\u652f\u6301\u76f4\u63a5\u6307\u5b9a\u5927\u5c0f\u521d\u59cb\u5316\n    N[0] = V;  // \u8bbe\u7f6e\u7b2c\u4e00\u4e2a\u5143\u7d20\n    \n    // \u586b\u5145\u6570\u7ec4\uff0c\u6bcf\u4e2a\u5143\u7d20\u662f\u524d\u4e00\u4e2a\u76842\u500d\n    for(size_t i = 1; i < N.size(); i++) {  // \u4f7f\u7528size_t (C++11\u63a8\u8350)\n        N[i] = N[i-1] * 2;\n    }\n    \n    // \u8f93\u51fa\u6570\u7ec4\n    for(size_t i = 0; i < N.size(); i++) {\n        cout << \"N[\" << i << \"] = \" << N[i] << endl;\n    }\n    \n    return 0;\n}"
